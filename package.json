{
  "name": "enocta-personas-poc",
  "version": "1.0.0",
  "description": "Enocta Personas projesi için PoC ortamı",
  "scripts": {
    "start:backend": "node backend/server.js",
    "clean": "rimraf dist && mkdir dist",
    "build": "webpack --mode production",
    "build:clean": "npm run clean && webpack --mode production",
    "dev": "concurrently \"npm run start:backend\" \"webpack serve --mode development\"",
    "dev:python": "concurrently \"uvicorn backend.server:app --reload --port 3000\" \"webpack serve --mode development\"",
    "dev:personas": "concurrently \"uvicorn backend.server:app --reload --port 3000\" \"webpack serve --mode development\"",
    "dev:mentor": "concurrently \"uvicorn backend.server:app --reload --port 3000\" \"webpack serve --mode development\"",
    "start": "npm run build && npm run start:backend",
    "start:python": "npm run build:clean && uvicorn backend.server:app --reload --port 3000",
    "build:personas": "npm run build:clean",
    "build:mentor": "npm run build:clean",
    "build:all": "npm run build:clean"
  },
  "dependencies": {
    "@11labs/client": "^0.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "concurrently": "^8.0.1",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "rimraf": "^5.0.10",
    "style-loader": "^4.0.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
